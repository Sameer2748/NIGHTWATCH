generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(uuid())
  name        String       @unique
  password    String?
  email       String?      @unique
  phoneNumber String?
  googleId    String?      @unique
  statusPages StatusPage[]
  websites    Website[]
}

model Website {
  id              String           @id @default(uuid())
  url             String
  timeAdded       DateTime
  user_id         String
  keywordCheck    String?          @default("")
  paused          Boolean          @default(false)
  grace_period    Int              @default(30)
  last_heartbeat  DateTime?
  period          Int              @default(180)
  type            MonitorType      @default(URL)
  escalationSteps EscalationStep[]
  incidents       Incident[]
  user            User             @relation(fields: [user_id], references: [id])
  ticks           WebsiteTick[]
  statusPages     StatusPage[]     @relation("StatusPageToWebsite")
}

model StatusPage {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  user_id     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [user_id], references: [id])
  monitors    Website[] @relation("StatusPageToWebsite")
}

model EscalationStep {
  id         String           @id @default(uuid())
  website_id String
  order      Int
  type       NotificationType
  value      String
  website    Website          @relation(fields: [website_id], references: [id])
}

model Region {
  id        String        @id @default(uuid())
  name      String
  incidents Incident[]
  ticks     WebsiteTick[]
}

model WebsiteTick {
  id               String        @id @default(uuid())
  response_time_ms Int
  status           WebsiteStatus
  region_id        String
  website_id       String
  createdAt        DateTime      @default(now())
  dns_time_ms      Int?
  download_time_ms Int?
  tcp_time_ms      Int?
  tls_time_ms      Int?
  ttfb_ms          Int?
  message          String?
  region           Region        @relation(fields: [region_id], references: [id])
  website          Website       @relation(fields: [website_id], references: [id])
}

model Incident {
  id             String          @id @default(uuid())
  website_id     String
  region_id      String
  startedAt      DateTime        @default(now())
  resolvedAt     DateTime?
  duration       Int?
  status         IncidentStatus  @default(ONGOING)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  acknowledgedAt DateTime?
  acknowledgedBy String?
  region         Region          @relation(fields: [region_id], references: [id])
  website        Website         @relation(fields: [website_id], references: [id])
  events         IncidentEvent[]
}

model IncidentEvent {
  id          String           @id @default(uuid())
  incident_id String
  type        NotificationType
  value       String           // Recipient email/phone number
  status      EventStatus      @default(PENDING)
  message     String?
  createdAt   DateTime         @default(now())
  incident    Incident         @relation(fields: [incident_id], references: [id])
}

enum MonitorType {
  URL
  HEARTBEAT
}

enum NotificationType {
  CALL
  SMS
  EMAIL
  PUSH
}

enum EventStatus {
  PENDING
  SENT
  FAILED
}

enum IncidentStatus {
  ONGOING
  RESOLVED
}

enum WebsiteStatus {
  Up
  Down
  Unknown
}
